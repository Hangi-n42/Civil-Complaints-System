# 환경 변수 샘플
# .env 파일로 복사해서 사용하세요

# API 설정
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# 회사 지식 K2 (사용 시 API/FE를 loopback으로 실행)
KNOWLEDGE_ENABLED=false
KNOWLEDGE_DB_PATH=data/knowledge/knowledge.db
# 빈 값이면 기존 공유 모델 사용. 역할별 교체 결과: docs/30_manuals/llm_two_model_selection.md
KNOWLEDGE_SEARCH_MODEL=
KNOWLEDGE_REVIEW_MODEL=qwen3.8:27b-q4_K_M
# A2 자료 탐색 검수 전용; K3 검수 모델과 독립
KNOWLEDGE_DISCOVERY_REVIEW_MODEL=gemma4:31b-it-q4_K_M

# Ollama 설정 (온디바이스 LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:31b-it-q4_K_M
OLLAMA_TIMEOUT=180
STRUCTURING_MODEL=gemma4:31b-it-q4_K_M
# 빈 값이면 STRUCTURING_MODEL. 민원 제약 구조화만 분리할 때 지정.
CIVIL_STRUCTURING_MODEL=gemma4:31b-it-q4_K_M
GENERATION_NUM_PREDICT=1536
GENERATION_NUM_CTX=8192
GROUNDING_FILTER_MODEL=gemma4:31b-it-q4_K_M
GROUNDING_FILTER_MAX_CONCURRENCY=5

# request_segments LLM 제한 assist 예시
# 기본값은 코드에서 off/none으로 유지됩니다. 운영 제한 가동 시 아래 값을 명시하세요.
# REQUEST_SEGMENT_LLM_MODE=assist
# REQUEST_SEGMENT_LLM_ASSIST_POLICY=v2_strict
# REQUEST_SEGMENT_LLM_PROVIDER=ollama
# REQUEST_SEGMENT_LLM_MODEL=gemma4:31b-it-q4_K_M
# REQUEST_SEGMENT_LLM_PROMPT_STYLE=block
# REQUEST_SEGMENT_LLM_BLOCK_NUM_PREDICT=256
# REQUEST_SEGMENT_LLM_SOURCE_BLOCK_LIMIT=30
# 긴급 롤백:
# REQUEST_SEGMENT_LLM_MODE=shadow
# 또는:
# REQUEST_SEGMENT_LLM_MODE=off

# Civil Complaint LLM-Rubric runtime evaluation
ENABLE_CIVIL_LLM_RUBRIC=true
CIVIL_LLM_RUBRIC_USE_LLM_JUDGE=true
CIVIL_LLM_RUBRIC_VERSION=civil_llm_rubric_q0_q7_v1.0
CIVIL_LLM_RUBRIC_JUDGE_PROMPT_VERSION=judge_prompt_2026_09_29_citation_claims
CIVIL_LLM_RUBRIC_MAX_CONTEXTS=5
CIVIL_LLM_RUBRIC_TEMPERATURE=0.0
ENABLE_PROMETHEUS_RUBRIC_FEEDBACK=true
PROMETHEUS_RUBRIC_TRIGGER_MAX_CHOICE=2.0
PROMETHEUS_RUBRIC_MAX_REGENERATION_ATTEMPTS=1
PROMETHEUS_RUBRIC_TEMPERATURE=0.0
# 빈 값이면 OLLAMA_MODEL. 피드백·재작성 모델을 생성 모델과 다르게 둘 때 지정.
PROMETHEUS_FEEDBACK_MODEL=qwen3.8:27b-q4_K_M
PROMETHEUS_REVISION_MODEL=gemma4:31b-it-q4_K_M

# Complaint Intelligence 실시간 관제 read-model 저장소
COMPLAINT_INTELLIGENCE_REPOSITORY=sqlite
COMPLAINT_INTELLIGENCE_DB_PATH=./data/complaint_intelligence/complaint_intelligence.db
COMPLAINT_INTELLIGENCE_DEFAULT_MODE=realtime
COMPLAINT_INTELLIGENCE_RETENTION_DAYS=90
COMPLAINT_INTELLIGENCE_AUTO_CREATE_DB=true
COMPLAINT_INTELLIGENCE_SCHEDULER_ENABLED=false
COMPLAINT_INTELLIGENCE_SCHEDULER_INTERVAL_SECONDS=300
COMPLAINT_INTELLIGENCE_SCHEDULER_BATCH_SIZE=500
COMPLAINT_INTELLIGENCE_SCHEDULER_MIN_EVENTS=1
COMPLAINT_INTELLIGENCE_SCHEDULER_SOURCE_NAME=repository_realtime
COMPLAINT_INTELLIGENCE_SCHEDULER_MODE=realtime
COMPLAINT_INTELLIGENCE_COLLECTOR=repository_replay
COMPLAINT_INTELLIGENCE_COLLECTOR_LIMIT=500
COMPLAINT_INTELLIGENCE_COLLECTOR_SOURCE_NAME=repository_replay
COMPLAINT_INTELLIGENCE_CHECKPOINT_ENABLED=true
PUBLIC_INSIGHT_LLM_SLOW_MS=180000
PUBLIC_INSIGHT_LLM_ENABLED=true
PUBLIC_INSIGHT_LLM_PROVIDER=fake
PUBLIC_INSIGHT_LLM_BASE_URL=http://localhost:11434
PUBLIC_INSIGHT_LLM_MODEL=gemma4:31b-it-q4_K_M
PUBLIC_INSIGHT_LLM_TIMEOUT_SECONDS=180
PUBLIC_INSIGHT_LLM_NUM_CTX=4096
PUBLIC_INSIGHT_LLM_NUM_PREDICT=1024
PUBLIC_INSIGHT_LLM_PROMPT_MODE=default
PUBLIC_INSIGHT_LLM_DEBUG_RAW_RESPONSE=false
PUBLIC_INSIGHT_LLM_DEBUG_RAW_RESPONSE_DIR=reports/llm_raw
PUBLIC_INSIGHT_LLM_DEBUG_RAW_RESPONSE_MAX_CHARS=4000
PUBLIC_INSIGHT_LLM_ACTION_RETRY_ENABLED=false

# ChromaDB 설정 (벡터 저장소)
CHROMA_DB_PATH=./data/chroma_db
DEFAULT_CHROMA_COLLECTION=civil_cases_v3

# 임베딩 모델
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cuda

# 성능 설정
MAX_WORKERS=4
REQUEST_TIMEOUT=60
BATCH_SIZE=32

# 검증 설정
MIN_CONFIDENCE_SCORE=0.5
MAX_RETRY_COUNT=3

# Rubric evaluation only; generation/revision retain OLLAMA_MODEL.
CIVIL_LLM_RUBRIC_MODEL=gemma4:31b-it-q4_K_M

# 두 모델 선정 근거·남은 한계: docs/30_manuals/llm_two_model_selection.md
# K3 설계만 이전 실측180초 초과에 따라 확장. 다른 단계는 OLLAMA_TIMEOUT 사용.
KNOWLEDGE_DESIGN_TIMEOUT=360
